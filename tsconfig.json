{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./resources/js/*"
      ],
      "@game/*": [
        "./game/*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "game",
    "resources/js",
    "tests/unit",
    "tests/helpers",
    "tests/browser",
    "tests/e2e",
    "*.ts"
  ]
}
