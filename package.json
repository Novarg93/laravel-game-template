{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:runtime",
    "build": "vite build",
    "check": "npm run test:suites && npm run typecheck && npm run lint && npm run test:runtime && npm run test:project && npm run build:ssr && npm run build:game && npm run test:browser && npm run test:browser:branding && npm run test:browser:content && npm run test:e2e && npm run test:e2e:production",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:production": "node scripts/e2e.mjs --preview",
    "preview": "vite preview --mode game --host 127.0.0.1",
    "prebuild": "node scripts/export-upgrade-catalog.mjs",
    "export:upgrades": "node scripts/export-upgrade-catalog.mjs",
    "build:ssr": "npm run build && vite build --ssr",
    "check:fix": "eslint game resources/js tests/unit tests/helpers tests/browser tests/e2e --fix",
    "types:check": "npm run typecheck",
    "dev:game": "vite --mode game --host 127.0.0.1 --port 5173",
    "build:game": "vite build --mode game",
    "preview:game": "vite preview --mode game --host 127.0.0.1",
    "test:catalog": "node scripts/export-upgrade-catalog.mjs --check",
    "test:project": "php artisan project:sync --check && npm run test:catalog && npm run check:assets",
    "check:assets": "node scripts/check-asset-packs.mjs",
    "test:browser": "node scripts/test-web.mjs",
    "test:browser:content": "node scripts/test-web.mjs --content-preview game-content.spec.ts",
    "test:browser:branding": "node scripts/test-web.mjs --branding-preview project-branding.spec.ts",
    "typecheck:runtime": "vue-tsc --noEmit -p tsconfig.runtime.json",
    "types:generate": "php artisan wayfinder:generate --with-form",
    "pretypecheck": "npm run types:generate",
    "typecheck:historical": "vue-tsc --noEmit -p tsconfig.historical.json",
    "pretypecheck:runtime": "npm run types:generate",
    "test:runtime": "vitest run --config vitest.config.ts",
    "test:historical": "vitest run --config vitest.historical.config.ts",
    "test:historical:replays": "npm run test:historical -- tests/historical/unit/endgame.test.ts tests/historical/unit/survival-enrage.test.ts -t \"preserves original\"",
    "test:all": "npm run test:runtime && npm run test:historical",
    "test:suites": "node scripts/check-test-suites.mjs",
    "test:e2e:historical": "node scripts/e2e.mjs --config=playwright.historical.config.ts",
    "test:e2e:historical:production": "node scripts/e2e.mjs --preview --config=playwright.historical.config.ts"
  },
  "dependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0",
    "@laravel/passkeys": "^0.2.0",
    "@lucide/vue": "^1.17.0",
    "@vueuse/core": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "laravel-vite-plugin": "^3.0.0",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.1",
    "tw-animate-css": "^1.2.5",
    "vue": "3.5.44",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "^10.0.3",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.13",
    "@playwright/test": "1.64.1",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-win32-x64-msvc": "^1.29.1"
  },
  "name": "laravel-game-template",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
