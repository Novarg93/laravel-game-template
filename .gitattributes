docs/architecture/GAME_BASELINE.log -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/architecture/GAME_AFTER.log -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/architecture/VALIDATION.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/architecture/DEPENDENCY_MAP_BEFORE.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
